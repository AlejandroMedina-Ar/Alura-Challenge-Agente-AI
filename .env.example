########################################################
# Para el Administrador
########################################################

# El Password del Administrador predeterminado es: "admin123"
# ⚠️ CRITICO: Cambia esto antes de cualquier despliegue público!
ADMIN_PASSWORD=admin123

########################################################
# Proveedores de LLM (v1: Gemini primary, Cohere fallback)
########################################################

# Google Gemini API Key (Free Tier)
# ⚠️ Coloca aqui tu propia API Key de Gemini para producción
GEMINI_API_KEY= Coloca aqui tu propia API Key de Gemini

GEMINI_MODEL=gemini-3.5-flash

# Cohere API Key (Free Tier)
# ⚠️ Coloca aqui tu propia API Key de Cohere para producción
COHERE_API_KEY= Coloca aqui tu propia API Key de Cohere

COHERE_MODEL=command-r

########################################################
# Embeddings
########################################################

# Modelo Multilenguaje optimizado para la recuperación semántica en español
# intfloat/multilingual-e5-base soporta 100+ languages incluido el español
# y singnificativamente mejora el rendimiento de modelos solo en inlges.

EMBEDDING_MODEL=intfloat/multilingual-e5-base

########################################################
# Vector Database
########################################################

CHROMA_DB_PATH=data/chromadb

CHROMA_COLLECTION=techflow_knowledge_base

########################################################
# Chunking
########################################################

CHUNK_SIZE=1000

CHUNK_OVERLAP=200

########################################################
# Configuración de Chat
########################################################

# Número de chunks a recuperar para el contexto
MAX_CONTEXT_CHUNKS=4

# Temperatura de generación de LLM (0.0 = determinístico, 1.0 = creativo)
TEMPERATURE=0.2

# Máximo tokens en la respuesta de LLM
MAX_OUTPUT_TOKENS=1024

########################################################
# Timeouts (segundos)
########################################################

# Máximo tiempo de espera para la respuesta de LLM (activa el fallback)
LLM_REQUEST_TIMEOUT=30

# Máximo tiempo de espera para la generación de embeddings
EMBEDDING_TIMEOUT=120

# Máximo tiempo de espera para consultas en ChromaDB
CHROMADB_TIMEOUT=10

########################################################
# Logging
########################################################

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Ruta al archivo de log
LOG_FILE=data/logs/application.log
